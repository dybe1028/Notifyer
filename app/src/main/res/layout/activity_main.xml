<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/app_background">

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/txtSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_subtitle"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_below="@id/txtTitle"
        android:layout_marginTop="6dp" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_empty"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_state"
            android:textSize="18sp"
            android:textColor="@color/text_empty"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_hint"
            android:textSize="14sp"
            android:textColor="@color/text_hint"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerNotify"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/txtSub"
        android:layout_above="@id/txtCredit"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/layout_animation_fall" />

    <!-- Credit -->
    <TextView
        android:id="@+id/txtCredit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Notifyer v0.6 beta • by DyBe"
        android:textSize="12sp"
        android:textColor="@color/text_hint"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="12dp" />

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/txtCredit"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="18dp"
        android:contentDescription="@string/add_reminder"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/app_accent"
        app:tint="@color/white" />

</RelativeLayout>
